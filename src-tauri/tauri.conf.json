{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Translator",
  "version": "0.2.0",
  "identifier": "com.livetranslator.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "strip",
        "title": "Live Translator strip",
        "width": 420,
        "height": 44,
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "popup",
        "title": "Live Translator popup",
        "width": 360,
        "height": 180,
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Live Translator",
        "url": "index.html",
        "width": 720,
        "height": 600,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Live in-field translator",
    "linux": {
      "deb": {
        "depends": [
          "libxkbcommon0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-live-translator.rules": "linux/70-live-translator.rules",
          "/usr/lib/modules-load.d/live-translator-uinput.conf": "linux/live-translator-uinput.conf"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}